# Primary API base URL. Required for production builds.
# The value may include or omit the /api/v1 suffix; the client normalises it.
# Example: https://api.example.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Legacy local-development alias. Ignored in production to avoid stale deploy URLs.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Set to "true" to load the local mock fixture instead of calling the real backend.
# Useful for frontend-only development when the backend is unavailable.
# Omit or set to "false" in all other environments.
NEXT_PUBLIC_USE_MOCK=false

# Set to "true" only for an explicitly enabled local development backend. This
# reveals the login-page Quick login control; production builds must leave it
# unset or false. The backend also requires DEV_QUICK_LOGIN=true.
NEXT_PUBLIC_DEV_QUICK_LOGIN=false

# Composition. Both are read by next.config.ts at BUILD time and inlined into
# the bundle, so changing either one requires a rebuild, not just a restart.
# Keep them in step with the backend's ALPHACI_BUILD_PROFILE and ALPHACI_EDITION:
# nothing cross-checks the two services, and a frontend built as saas against an
# enterprise backend will serve the public marketing site on that deployment.
#
# ALPHACI_BUILD_PROFILE - artifact ceiling. hosted | enterprise.
#   hosted compiles the SaaS and EDU surfaces; enterprise compiles the Enterprise
#   surface and replaces excluded feature barrels with a notFound stub.
#   Defaults to enterprise when unset.
# ALPHACI_EDITION - which product this deployment is. saas | edu | enterprise.
#   The profile cannot decide this on its own: the hosted profile covers BOTH
#   saas and edu, so the edition is what separates them. The public marketing
#   landing at / is served only when this is saas; edu and enterprise redirect
#   to /login. Anything unset or unrecognised also redirects, by design.
# This template selects the local SaaS surface. Use scripts/run-edition.mjs to
# run edu or enterprise without editing this file.
ALPHACI_BUILD_PROFILE=hosted
ALPHACI_EDITION=saas
