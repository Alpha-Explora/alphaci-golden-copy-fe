# Primary API base URL (canonical — preferred over NEXT_PUBLIC_API_URL).
# The value may include or omit the /api/v1 suffix; the client normalises it.
# Fallback chain: NEXT_PUBLIC_API_BASE_URL → NEXT_PUBLIC_API_URL → http://localhost:4000/api/v1
NEXT_PUBLIC_API_BASE_URL=https://flowci-be-test.onrender.com/api/v1

# Legacy alias accepted by the API client as a fallback (optional).
# Set this only if you cannot set NEXT_PUBLIC_API_BASE_URL.
# NEXT_PUBLIC_API_URL=https://flowci-be-test.onrender.com/api/v1

# Set to "true" to load the local mock fixture instead of calling the real backend.
# Useful for frontend-only development when the backend is unavailable.
# Omit or set to "false" in all other environments.
NEXT_PUBLIC_USE_MOCK=false
