# Primary API base URL. Required for production builds.
# The value may include or omit the /api/v1 suffix; the client normalises it.
# Example: https://api.example.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Legacy local-development alias. Ignored in production to avoid stale deploy URLs.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Set to "true" to load the local mock fixture instead of calling the real backend.
# Useful for frontend-only development when the backend is unavailable.
# Omit or set to "false" in all other environments.
NEXT_PUBLIC_USE_MOCK=false
