# Hosted SaaS build.
# These two are read by next.config.ts at BUILD time and inlined into the
# bundle, so switching requires a rebuild or a dev-server restart.
#
# Keep them in step with the backend file of the same name. Nothing
# cross-checks the two services.
# The public marketing landing at / is served only by this combination.
ALPHACI_BUILD_PROFILE=hosted
ALPHACI_EDITION=saas
