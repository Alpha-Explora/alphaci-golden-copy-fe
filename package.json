{
  "name": "cicd-fe-single",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:saas": "node scripts/run-edition.mjs saas next dev --turbopack",
    "dev:edu": "node scripts/run-edition.mjs edu next dev --turbopack",
    "dev:enterprise": "node scripts/run-edition.mjs enterprise next dev --turbopack",
    "build": "next build --webpack",
    "build:saas": "node scripts/run-edition.mjs saas next build --webpack",
    "build:edu": "node scripts/run-edition.mjs edu next build --webpack",
    "build:enterprise": "node scripts/run-edition.mjs enterprise next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "tsx tests/e2e/playwright-e2e.ts",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings=742",
    "complexity": "node scripts/check-complexity.cjs",
    "arch:check": "node scripts/check-boundaries.mjs --cwd . --src auto",
    "arch:check:touched": "node scripts/check-boundaries.mjs --cwd . --src auto --since origin/main",
    "arch:new": "node \"${NFA:-$HOME/.agents/skills/next-feature-architecture}/scripts/scaffold-feature.mjs\"",
    "check:okf": "node scripts/check-okf-bundle.cjs docs",
    "check:capabilities": "node scripts/check-capabilities.cjs",
    "check:capability-package": "node scripts/check-capability-package.cjs",
    "check:profiles": "node scripts/check-build-profiles.cjs",
    "build:profile": "node scripts/build-profile.cjs",
    "generate:architecture-maps": "node scripts/generate-architecture-maps.mjs",
    "check:documentation": "node scripts/check-documentation.cjs"
  },
  "dependencies": {
    "driver.js": "^1.4.0",
    "framer-motion": "^12.38.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "js-yaml": "^4.3.2",
    "playwright": "^1.59.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  },
  "overrides": {
    "flatted": "3.4.2"
  }
}
